# Copy to `back the app already uses).
# `docker-compose.prod.yml` overrides DATABASE_URL and REDIS_URL to use the
# compose services; you do not need to duplicate those here unless you remove
# those `environment` entries from the compose file.

NODE_ENV=production
# Compose overrides DATABASE_URL. For Atlas instead, set a placeholder and remove the compose override:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority"

JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
PORT=3001

# API-Football ingestion (API-Sports). Set ENABLE_API_FOOTBALL_CRON=true to run sync jobs on startup.
# API_FOOTBALL_KEY=
# REDIS_URL=redis://localhost:6379
# ENABLE_API_FOOTBALL_CRON=false
#
# DATABASE_URL="mongodb://127.0.0.1:27018/kizzabet?replicaSet=rs0&directConnection=true"

# ─── API-Sports ingestion ────────────────────────────────────────────────
# Comma-separated list of sport slugs to fetch from API-Sports.
# Supported slugs: football, basketball, baseball, hockey, rugby, american-football
# Only currently-subscribed sports should be listed here.
ENABLED_SPORTS=football

# Per-sport API keys (set only the ones you're subscribed to).
API_FOOTBALL_KEY=

# API_BASKETBALL_KEY=
# API_BASEBALL_KEY=
# API_HOCKEY_KEY=
# API_RUGBY_KEY=
# API_AMERICAN_FOOTBALL_KEY=

# Global HTTP tuning for the API-Sports client (optional)
API_SPORTS_TIMEOUT_MS=30000
API_SPORTS_MAX_RETRIES=2
API_SPORTS_DAILY_LIMIT=75000

# Max active leagues ingested per bulk sync (top by rank). Default 200.
INGEST_ACTIVE_CAP=200
# Max non-top leagues in sidebar catalog; top section (ranks 1–8 + product priority) is separate.
SIDEBAR_ACTIVE_CAP=200

ENABLE_API_FOOTBALL_CRON=true

# Redis
REDIS_URL=redis://localhost:6379

REDIS_KEY_PREFIX="kizzabet"
API_SPORTS_CACHE_TTL=300


FORCE_BOOTSTRAP=true

ODDS_MAX_FIXTURES_PER_RUN=150
LIVE_POLL_SECONDS=60
LIVE_SCORE_POLL_SECONDS=5
ODDS_INTERVAL_SECONDS=180


# Odds ingestion limits
ODDS_MAX_FIXTURES_PER_RUN=250
ODDS_HORIZON_BACKFILL_MAX=2000



# DATABASE_URL="mongodb://127.0.0.1:27018/kizzabet?replicaSet=rs0&directConnection=true"
# REDIS_URL="redis://localhost:6379"


# Odds ingest/query horizon (UTC days). When unset, tracks FIXTURES_DAYS_AHEAD.
# ODDS_HORIZON_DAYS=14
FIXTURES_DAYS_AHEAD=14
ODDS_HORIZON_DAYS=14
# Prefer fixtures kicking off within this many UTC calendar days when ranking odds work (within ODDS_HORIZON_DAYS).
ODDS_NEAR_PRIORITY_DAYS=2

# After admin preferred bookmaker, try these API-Sports bookmaker ids in order (comma-separated).
# When unset, sync uses DEFAULT_BOOKMAKER_FALLBACK_CHAIN (Marathonbet, 1xBet, …) after preferred.
# Example override: BOOKMAKER_FALLBACK_CHAIN=2,11,16,34,32,3
BOOKMAKER_FALLBACK_CHAIN=

# When true, list endpoints hide fixtures missing preferred-bookmaker odds. Default false lists fixtures with fallback odds.
PUBLIC_FIXTURES_STRICT_BOOKMAKER=false

# -------------------------------------------

# Default min(3, FIXTURES_DAYS_AHEAD). Set to 1 for legacy “today-only” API volume per tick.
FIXTURES_NEAR_WINDOW_DAYS=

# Optional overrides for repeatable cadences (hours). When unset, FIXTURES_TODAY_HOURS / FIXTURES_FUTURE_HOURS apply.
FIXTURES_NEAR_INTERVAL_HOURS=
FIXTURES_DEEP_INTERVAL_HOURS=



CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API environment variable
# CLOUDINARY_URL=cloudinary://${CLOUDINARY_API_KEY}:${CLOUDINARY_API_SECRET}@${CLOUDINARY_CLOUD_NAME}
ENABLE_API_FOOTBALL_CRON=true





PAYMENT_VERIFY_BASE_URL=https://verifyapi.leulzenebe.pro
PAYMENT_VERIFY_API_KEY=sk_live_REPLACE_ME


CORS_ORIGINS="https://asmatbet.com,https://admin.asmatbet.com"


# ─── InOut Games integration ─────────────────────────────────────────────
# Seamless-wallet casino provider. Real secrets belong in backend/.env
# (or backend/.env.staging on the VPS) — never commit them.
#
# Operator ID (UUID) issued by InOut for this environment.
INOUT_OPERATOR_ID=
# HMAC-SHA256 key used to verify inbound webhook signatures (X-REQUEST-SIGN)
# and to sign outbound bonus API calls. SECRET — do not commit.
INOUT_SIGNATURE_KEY=
# Base URL for the game launch endpoint (default shown).
INOUT_LAUNCH_BASE_URL=https://api.golden-eggs.games/api/launch
# Base URL for InOut REST endpoints (gameModesList catalog sync). Default shown.
INOUT_API_BASE_URL=https://api.inout.games/api
# Demo/spectator operator id from InOut frontend docs (default shown). Demo
# launches use this operator with currency=DEMO; our own operator id is passed
# as themeId for branded loading screens.
INOUT_DEMO_OPERATOR_ID=ee2013ed-e1f0-4d6e-97d2-f36619e2eb52
# Default player currency for launch + webhooks.
INOUT_DEFAULT_CURRENCY=ETB
# Default ISO country code for launch URLs (InOut requires userCountryCode).
INOUT_DEFAULT_COUNTRY=ET
# Optional label from InOut onboarding (e.g. michotbet-prod — keep until InOut reissues for AsmatBet).
INOUT_ALIAS=

# ─── MRX Instant Games (SSO + wallet bridge) ──────────────────────────────
# AES-256 key material as 64 hex chars (first 64 hex → 32-byte key). Must match MRX.
MRX_ENCRYPTION_KEY=
# Shared secret for POST /api/internal/wallet/adjust-balance (x-api-key). Must match MRX.
INTERNAL_BRIDGE_KEY=